Deutsch Algorithm:
Problem Statement: Write a Python program using Qiskit to implement the Deutsch Algorithm.
from qiskit import QuantumCircuit, transpile
from qiskit_aer import Aer
def deutsch_oracle(case='balanced'):
    oracle = QuantumCircuit(2)
    if case == 'constant_0':pass
    elif case == 'constant_1':
        oracle.x(1)
    elif case == 'balanced_identity':
        oracle.cx(0, 1)
    elif case == 'balanced_not':
        oracle.x(1)
        oracle.cx(0, 1)
    return oracle
def deutsch_algorithm(case):
    qc = QuantumCircuit(2, 1)
    qc.x(1)          
    qc.h([0, 1])     
    qc.append(deutsch_oracle(case), [0, 1]) 
    qc.h(0)          
    qc.measure(0, 0)
    return qc
simulator = Aer.get_backend('qasm_simulator')
for case in ['constant_0', 'constant_1', 'balanced_identity', 'balanced_not']:
    print(f"\n=========")
    print(f"CASE: {case}")
    print(f"===========")
    qc = deutsch_algorithm(case)
    print("\n[Text-Based Circuit Diagram]")
    print(qc.draw(output='text'))
    fig = qc.draw(output='mpl')
    filename = f"circuit_{case}.png"
    fig.savefig(filename)
    print(f"\n[Image Graphic] Saved successfully as: '{filename}'")
    display(fig)
    tqc = transpile(qc, simulator)
    job = simulator.run(tqc, shots=1024)
    result = job.result()
    counts = result.get_counts()
    print(f"\nSimulation Result Counts: {counts}")
    if '0' in counts:
        print("-> Conclusion: Function is CONSTANT\n")
    else:
        print("-> Conclusion: Function is BALANCED\n")










Deutsch–Jozsa Algorithm:
Problem Statement: Write a Python program using Qiskit to implement the Deutsch-Jozsa Algorithm.

from qiskit import QuantumCircuit, transpile
from qiskit_aer import Aer
import numpy as np
def deutsch_jozsa_oracle(case, n):
    """
    Generates a Deutsch-Jozsa oracle (U_f) for 'n' input qubits.
    Total qubits = n + 1 (The last qubit at index 'n' is the output target qubit).
    """
    oracle = QuantumCircuit(n + 1)
        if case == 'constant':
        output_bit = np.random.randint(2)
        if output_bit == 1:
            oracle.x(n) # Flip the output qubit
        elif case == 'balanced':
         b_str = format(np.random.randint(1, 2**n), f'0{n}b')
         for qubit in range(n):
            if b_str[qubit] == '1':
                oracle.x(qubit)
        for qubit in range(n):
            oracle.cx(qubit, n)
        for qubit in range(n):
            if b_str[qubit] == '1':
                oracle.x(qubit)
     return oracle
def deutsch_jozsa_algorithm(case, n):
    """
    Constructs the full dynamic Deutsch-Jozsa circuit for 'n' input bits.
    ""
    qc = QuantumCircuit(n + 1, n)
    qc.x(n)
    qc.h(range(n + 1))
    qc.append(deutsch_jozsa_oracle(case, n), range(n + 1))
    qc.h(range(n))
    qc.measure(range(n), range(n))
    return qc
N_INPUT_BITS = 3 
simulator = Aer.get_backend('qasm_simulator')
for case in ['constant', 'balanced']:
    print(f"\n==========================================")
    print(f"CASE: {case.upper()} ({N_INPUT_BITS} Input Qubits)")
    print(f"==========================================")
    qc = deutsch_jozsa_algorithm(case, N_INPUT_BITS)
    print("\n[Text-Based Circuit Diagram]")
    print(qc.draw(output='text'))
    
    
    fig = qc.draw(output='mpl')
    filename = f"dj_circuit_{case}_{N_INPUT_BITS}bit.png"
    fig.savefig(filename)
    print(f"\n[Image Graphic] Saved successfully as: '{filename}'")
    display(fig)
    tqc = transpile(qc, simulator)
    job = simulator.run(tqc, shots=1024)
    result = job.result()
    counts = result.get_counts()
    print(f"\nSimulation Result Counts: {counts}")
    all_zeros_string = '0' * N_INPUT_BITS
    if all_zeros_string in counts:
        print("-> Conclusion: Function is CONSTANT\n")
    else:
        print("-> Conclusion: Function is BALANCED\n")










 



	












	

 
